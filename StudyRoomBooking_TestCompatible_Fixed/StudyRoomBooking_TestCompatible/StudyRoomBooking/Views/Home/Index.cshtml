@model RoomSearchViewModel
@{ ViewData["Title"] = "Find a room"; }

<h1>Study Room Booking</h1>
<p>Choose a time to find a room for your study session.</p>

<form method="get" class="border rounded p-3 mb-4">
    <input type="hidden" name="Searched" value="true" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row g-3 align-items-end">
        <div class="col-12 col-md-3">
            <label for="StartTime" class="form-label">Start time</label>
            <input type="datetime-local" id="StartTime" name="StartTime" class="form-control" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-12 col-md-3">
            <label for="EndTime" class="form-label">End time</label>
            <input type="datetime-local" id="EndTime" name="EndTime" class="form-control" value="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-6 col-md-2">
            <label for="Floor" class="form-label">Floor (optional)</label>
            <input type="number" id="Floor" name="Floor" min="0" max="10" class="form-control" value="@Model.Floor" />
        </div>
        <div class="col-6 col-md-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="NeedsProjector" value="true" id="NeedsProjector" @(Model.NeedsProjector ? "checked" : "") />
                <label class="form-check-label" for="NeedsProjector">Projector</label>
            </div>
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-primary w-100">Search</button>
        </div>
    </div>
</form>

@if (Model.Searched && ViewData.ModelState.IsValid)
{
    @if (!Model.Results.Any())
    {
        <p class="alert alert-info">No rooms are free at that time. Try another time.</p>
    }
    else
    {
        <h2>Available rooms</h2>
        <p>@Model.Results.Count room@(Model.Results.Count == 1 ? "" : "s") found.</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr><th>Room</th><th>Floor</th><th>Capacity</th><th>Projector</th><th></th></tr>
                </thead>
                <tbody>
                @foreach (var room in Model.Results)
                {
                    <tr>
                        <td>@room.Name</td>
                        <td>@room.Floor</td>
                        <td>@room.Capacity</td>
                        <td>@(room.HasProjector ? "Yes" : "No")</td>
                        <td>
                            <a class="btn btn-primary btn-sm" asp-controller="Bookings" asp-action="Create"
                               asp-route-roomId="@room.Id" asp-route-start="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")"
                               asp-route-end="@Model.EndTime.ToString("yyyy-MM-ddTHH:mm")">Book</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
