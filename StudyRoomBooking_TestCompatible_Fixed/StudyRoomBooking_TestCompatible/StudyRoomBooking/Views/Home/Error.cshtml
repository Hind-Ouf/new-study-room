@{ ViewData["Title"] = "Error"; }
<div class="text-center py-5">
    <h1 class="display-5 text-danger"> Something went wrong</h1>
    <p class="lead">@(ViewBag.Code == 404 ? "We could not find that page." : "An unexpected error occurred. It has been logged.")</p>
    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to start</a>
</div>
